# ===================================================================
# StyleRadar - PT8080-Donations-Service (ms-segunda-vida-donaciones)
# Plantilla Completa de Variables de Entorno (.env.example)
# Squad Portal8080 · DOSW 2026
#
# INSTRUCCIONES:
#   cp .env.example .env
# NUNCA subas el archivo '.env' con secretos reales al repositorio Git.
# ===================================================================

# -------------------------------------------------------------------
# Configuración del Microservicio y Trazabilidad
# -------------------------------------------------------------------
PORT=8520
SERVER_PORT=8520
SPRING_PROFILES_ACTIVE=dev
APP_COMMIT_SHA=local-dev
STYLERADAR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SECOND_HAND_PUBLICATION_BY_ID_PATH=/api/v1/second-hand/publications/{id}

# -------------------------------------------------------------------
# Persistencia PostgreSQL y Migraciones Flyway
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=styleradar_donations
DB_USER=styleradar_user
DB_PASSWORD=styleradar_secret
DB_SSLMODE=
# Alternativa JDBC completa (opcional en QA/PROD con sslmode=require):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/styleradar_donations

# -------------------------------------------------------------------
# Broker de Mensajería RabbitMQ (TCP local 5672/5674 o AMQPS TLS 5671)
# -------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5674
RABBITMQ_USER=guest
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Seguridad TLS AMQPS (en QA/PROD habilitar true y apuntar al truststore JKS/PKCS12)
RABBITMQ_SSL_ENABLED=false
RABBITMQ_TRUSTSTORE_PATH=classpath:certs/rabbitmq-truststore.jks
RABBITMQ_TRUSTSTORE_PASSWORD=changeit
RABBITMQ_TRUSTSTORE_TYPE=PKCS12
RABBITMQ_SSL_VERIFY_HOSTNAME=true

# Topología, Exchanges, Colas y Routing Keys (StyleRadar Exchange)
RABBITMQ_DECLARE_TOPOLOGY=true
RABBITMQ_LISTENER_AUTO_STARTUP=true
RABBITMQ_SIMULATOR_ENABLED=false
RABBITMQ_EXCHANGE=styleradar.exchange
RABBITMQ_CHAT_EXCHANGE=styleradar.exchange
RABBITMQ_DONATIONS_EXCHANGE=styleradar.exchange
RABBITMQ_DLX=styleradar.dlx
RABBITMQ_DLQ=styleradar.donaciones.dlq
RABBITMQ_FOUNDATION_DELETED_QUEUE=styleradar.donaciones.foundation-deleted.q
RABBITMQ_NOTIFICATIONS_QUEUE=q.notificaciones.donacion-solicitud-creada
RABBITMQ_SIMULATOR_QUEUE=q.donaciones.simulador-notificaciones
RABBITMQ_ROUTING_KEY_DONACION=styleradar.donaciones.estado.cambiado
RABBITMQ_ROUTING_KEY_DONACION_COMPLETADA=styleradar.donaciones.completada
RABBITMQ_ROUTING_KEY_DONACION_CREATED=styleradar.donaciones.solicitud.creada
RABBITMQ_ROUTING_KEY_SEGUNDA_VIDA=segunda-mano.prenda.vendida
RABBITMQ_ROUTING_KEY_NOTIFICACIONES_SEGUNDA_VIDA=styleradar.segundavida.prenda.vendida
RABBITMQ_ROUTING_KEY_FOUNDATION_DELETED=foundation.deleted

# -------------------------------------------------------------------
# Seguridad y Autenticación Bearer JWT (HS256 >= 256 bits en Base64)
# Generar con: openssl rand -base64 32
# Alias soportados: JWT_SECRET_BASE64, SECURITY_JWT_SECRET, JWT_SECRET, JWT_SECRET_KEY
# -------------------------------------------------------------------
JWT_SECRET_BASE64=reemplazar_con_secreto_jwt_base64_de_minimo_256_bits
JWT_DURATION=PT24H
# SECURITY_JWT_SECRET=
# JWT_SECRET=
# JWT_SECRET_KEY=

# -------------------------------------------------------------------
# Integración Síncrona con ms-tiendas (Catálogo y Validación RBAC)
# -------------------------------------------------------------------
TIENDAS_SERVICE_URL=http://localhost:8140
TIENDAS_VALIDATION_ENABLED=true
TIENDAS_FOUNDATIONS_PATH=/api/v1/foundations
TIENDAS_FOUNDATION_BY_ID_PATH=/api/v1/internal/foundations/{id}
TIENDAS_FOUNDATION_BY_REPRESENTATIVE_PATH=/api/v1/internal/foundations?representativeId={representativeId}
TIENDAS_REPRESENTATIVE_FALLBACK_PATH=/api/v1/foundations/representative
TIENDAS_INTERNAL_USERNAME=ms-donaciones
TIENDAS_INTERNAL_PASSWORD=reemplazar_con_password_interno_tiendas
TIENDAS_SERVICE_TOKEN=
TIENDAS_FORWARD_BEARER_TOKEN=false
TIENDAS_SERVICE_ROLES_HEADER=X-User-Roles
TIENDAS_SERVICE_ROLES_VALUE=ROLE_ADMIN_STYLERADAR
TIENDAS_CONNECT_TIMEOUT_MS=3000
TIENDAS_READ_TIMEOUT_MS=5000

# -------------------------------------------------------------------
# Almacenamiento en la Nube - Azure Blob Storage (Fotografías de Prendas)
# -------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<tu-cuenta>;AccountKey=<tu-clave>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=donaciones-fotos
AZURE_STORAGE_BLOB_ENDPOINT=https://srdonacionesjmunar.blob.core.windows.net
