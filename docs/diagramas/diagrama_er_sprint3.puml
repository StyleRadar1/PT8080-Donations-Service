@startuml diagrama_er_sprint3
title ms-segunda-vida-donaciones - Diagrama Entidad-Relación PostgreSQL (styleradar_donations)

entity "publicaciones_segunda_mano" as pub {
    * id : BIGINT <<PK, GENERATED>>
    --
    * usuario_id : BIGINT <<ms-usuarios>>
    * nombre_prenda : VARCHAR(120)
    descripcion : VARCHAR(1000)
    * tipo_prenda : VARCHAR(30)
    * marca : VARCHAR(80)
    * color : VARCHAR(50)
    * estilo : VARCHAR(30)
    * talla : VARCHAR(20)
    * estado_conservacion : VARCHAR(30)
    * precio : NUMERIC(12,2)
    * es_donacion : BOOLEAN
    * localidad : VARCHAR(50)
    * estado : VARCHAR(30)
    * version : BIGINT
    * fecha_publicacion : TIMESTAMP_TZ
    fecha_actualizacion : TIMESTAMP_TZ
}

entity "fotos_publicacion" as foto {
    * id : BIGINT <<PK, GENERATED>>
    --
    * publicacion_id : BIGINT <<FK>>
    * url_foto : VARCHAR(512)
    * orden : INTEGER
}

entity "solicitudes_donacion" as sol {
    * id : BIGINT <<PK, GENERATED>>
    --
    * publicacion_id : BIGINT <<FK>>
    * donante_id : BIGINT <<ms-usuarios>>
    * fundacion_id : BIGINT <<ms-usuarios>>
    mensaje : VARCHAR(500)
    * estado : VARCHAR(30)
    motivo_rechazo : VARCHAR(500)
    punto_entrega : VARCHAR(255)
    franja_inicio : TIMESTAMP_TZ
    franja_fin : TIMESTAMP_TZ
    * version : BIGINT
    * fecha_solicitud : TIMESTAMP_TZ
    fecha_decision : TIMESTAMP_TZ
    fecha_recepcion : TIMESTAMP_TZ
}

pub ||--o{ foto : "1..4 fotos"
pub ||--o{ sol : "solicitudes benéficas"

@enduml
