        <mxCell id="lp_br_subStats" parent="1" style="ellipse;html=1;fillColor=none;strokeColor=none;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" value="" vertex="1">
