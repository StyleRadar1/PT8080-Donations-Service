@startuml diagrama_clases_sprint3
title ms-segunda-vida-donaciones - Diagrama de Clases de Dominio y Puertos (Hexagonal)

package "Domain Layer (Pure Java)" {
    class SecondHandPublication <<Aggregate Root>> {
        - Long id
        - Long userId
        - Garment garment
        - Size size
        - ConservationStatus conservationStatus
        - BigDecimal price
        - boolean esDonacion
        - LocalidadBogota localidad
        - PublicationStatus status
        - Long version
        - List<String> photos
        - LocalDateTime publishedAt
        - LocalDateTime updatedAt
        + void validateInvariants()
        + void publish()
        + void edit(...)
        + void markAsSold()
        + void retire()
        + void markForDonation()
        + void markAsDonated()
    }

    class Garment <<Value Object>> {
        - String name
        - String description
        - GarmentType garmentType
        - String brand
        - String color
        - Style style
        + void validateInvariants()
    }

    class DonationRequest <<Entity>> {
        - Long id
        - Long publicationId
        - Long donorId
        - Long foundationId
        - String message
        - DonationRequestStatus status
        - String rejectionReason
        - String deliveryPoint
        - LocalDateTime pickupStartTime
        - LocalDateTime pickupEndTime
        - Long version
        - LocalDateTime requestedAt
        - LocalDateTime decidedAt
        - LocalDateTime receivedAt
        + void initiate()
        + void approve()
        + void reject(String reason)
        + void schedulePickup(...)
        + void confirmReceipt()
    }

    enum LocalidadBogota {
        USAQUEN
        CHAPINERO
        SANTA_FE
        SAN_CRISTOBAL
        USME
        TUNJUELITO
        BOSA
        KENNEDY
        FONTIBON
        ENGATIVA
        SUBA
        BARRIOS_UNIDOS
        TEUSAQUILLO
        LOS_MARTIRES
        ANTONIO_NARINO
        PUENTE_ARANDA
        LA_CANDELARIA
        RAFAEL_URIBE_URIBE
        CIUDAD_BOLIVAR
        SUMAPAZ
    }

    enum PublicationStatus {
        AVAILABLE
        SOLD
        IN_DONATION
        DONATED
        RETIRED
    }

    enum DonationRequestStatus {
        PENDING
        ACCEPTED
        REJECTED
        SCHEDULED
        DELIVERED
        CANCELLED
    }

    SecondHandPublication *-- Garment
    SecondHandPublication --> LocalidadBogota
    SecondHandPublication --> PublicationStatus
    DonationRequest --> DonationRequestStatus
    SecondHandPublication "1" <-- "0..*" DonationRequest
}

package "Application Layer (Use Cases & Ports)" {
    interface CreatePublicationUseCase {
        + SecondHandPublication create(CreatePublicationCommand)
    }
    interface ManagePublicationUseCase {
        + SecondHandPublication edit(Long, EditPublicationCommand)
        + void retire(Long, Long)
        + void markAsSold(Long, Long)
        + void markForDonation(Long, Long)
    }
    interface ClaimDonationUseCase {
        + DonationRequest claimDonation(ClaimDonationCommand)
    }
    interface PublicationRepositoryPort {
        + SecondHandPublication save(SecondHandPublication)
        + Optional<SecondHandPublication> findById(Long)
        + List<SecondHandPublication> search(PublicationSearchCriteria)
    }
    interface DonationRequestRepositoryPort {
        + DonationRequest save(DonationRequest)
        + Optional<DonationRequest> findById(Long)
        + List<DonationRequest> findByDonorId(Long)
        + List<DonationRequest> findByFoundationId(Long)
        + boolean existsActiveRequestForPublication(Long)
    }
    interface DonationEventPublisherPort {
        + void publishEvent(Object)
    }
}

@enduml
