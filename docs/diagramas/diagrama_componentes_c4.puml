@startuml diagrama_componentes_c4
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Componentes C4 (Nivel 3) - ms-segunda-vida-donaciones (Puerto 8520)

Container_Boundary(ms_boundary, "ms-segunda-vida-donaciones") {
    Component(sec_filter, "Security & JWT RBAC Filter", "Spring Security", "Valida JWT y roles (USER, FOUNDATION, STORE, ADMIN)")
    
    Component(pub_ctrl, "SecondHandPublicationController", "Spring MVC REST Controller", "Expone API /api/v1/publications (CRUD reventa y donaciones)")
    Component(don_ctrl, "DonationRequestController", "Spring MVC REST Controller", "Expone API /api/v1/donations (Vitrina abierta, reclamos, logística)")
    Component(auth_ctrl, "AuthController", "Spring MVC REST Controller", "Generación de tokens JWT de prueba para Swagger")
    Component(health_ctrl, "HealthController", "Spring MVC REST Controller", "Health check y readiness probe")

    Component(uc_pub, "Publication Use Cases", "Java Service", "CreatePublication, ManagePublication, GetPublications")
    Component(uc_don, "Donation Use Cases", "Java Service", "CreateDonation, ClaimDonation (Vitrina Abierta), DecideDonation, SchedulePickup, ConfirmReceipt")

    Component(domain_core, "Domain Core Model", "Pure Java (POJO)", "SecondHandPublication, DonationRequest, Garment, LocalidadBogota")

    Component(jpa_pub, "PublicationPersistenceAdapter", "Spring Data JPA / Hibernate", "Mapeo y persistencia relacional con control @Version")
    Component(jpa_don, "DonationPersistenceAdapter", "Spring Data JPA / Hibernate", "Mapeo y persistencia relacional de solicitudes")
    Component(rabbit_pub, "DonationEventPublisherAdapter", "Spring AMQP / RabbitTemplate", "Publicación asíncrona AMQPS TLS hacia broker central")
}

ContainerDb(db, "PostgreSQL Database", "PostgreSQL 16", "Esquema styleradar_donations")
Container(rabbit, "RabbitMQ Broker QA", "AMQPS TLS (Puerto 5671)", "Exchange: styleradar.exchange / DLX: styleradar.dlx")
Container(ms_chat, "ms-chat", "Microservicio Externo", "Cola: q.chat.segunda-mano")
Container(ms_notif, "ms-notificaciones", "Microservicio Externo", "Colas: q.notificaciones.*")

Rel(sec_filter, pub_ctrl, "Filtra y autoriza", "HTTP")
Rel(sec_filter, don_ctrl, "Filtra y autoriza", "HTTP")
Rel(pub_ctrl, uc_pub, "Invoca casos de uso")
Rel(don_ctrl, uc_don, "Invoca casos de uso")

Rel(uc_pub, domain_core, "Aplica invariantes de dominio")
Rel(uc_don, domain_core, "Aplica invariantes de dominio")

Rel(uc_pub, jpa_pub, "Persiste publicaciones")
Rel(uc_pub, rabbit_pub, "Emite styleradar.segundavida.prenda.vendida")
Rel(uc_don, jpa_don, "Persiste solicitudes")
Rel(uc_don, rabbit_pub, "Emite styleradar.donaciones.estado.cambiado")

Rel(jpa_pub, db, "JDBC / SQL", "TCP 5434/5432")
Rel(jpa_don, db, "JDBC / SQL", "TCP 5434/5432")

Rel(rabbit_pub, rabbit, "AMQPS TLS 5671", "styleradar.exchange")
Rel(rabbit, ms_chat, "Entrega eventos venta C2C")
Rel(rabbit, ms_notif, "Entrega eventos ciclo donación")

@enduml
